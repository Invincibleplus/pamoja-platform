                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                    <div>
                      <div className="badge badge-primary" style={{ marginBottom: '8px' }}>{session.lab.country}</div>
                      <h3 style={{ fontSize: '1.25rem', display: 'flex', gap: '8px', alignItems: 'flex-start', color: 'var(--text-main)' }}>
                        <MapPin size={20} color="var(--accent)" style={{ flexShrink: 0, marginTop: '4px' }} />
                        {session.lab.name}
                      </h3>
                    </div>
                  </div>
                  
                  <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
                    <h4 style={{ fontSize: '1rem', color: 'var(--text-muted)', borderBottom: '1px solid var(--border)', paddingBottom: '8px' }}>Available Time Blocks</h4>
                    
                    {session.blocks.map((block, bIdx) => {
                      const isFull = block.booked >= block.total;
                      const isMyBooking = myBookings.some(b => b.sessionId === session.id && b.time === block.time);
                      const isLoading = bookingStatus?.sessionId === session.id && bookingStatus?.time === block.time && bookingStatus?.status === 'loading';
                      const isSuccess = isMyBooking || (bookingStatus?.sessionId === session.id && bookingStatus?.time === block.time && bookingStatus?.status === 'success');

                      return (
                        <div key={bIdx} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', background: 'var(--surface)', padding: '16px', borderRadius: 'var(--radius-md)', border: isSuccess ? '1px solid var(--success)' : '1px solid var(--border)', transition: 'all 0.2s' }}>
                          <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                            <Clock size={20} color={isFull && !isSuccess ? "var(--text-muted)" : "var(--primary)"} />
                            <div>
                              <p style={{ fontWeight: 600, color: isFull && !isSuccess ? 'var(--text-muted)' : 'var(--text-main)', fontSize: '1.1rem' }}>{block.time}</p>
                              <p style={{ fontSize: '0.85rem', color: 'var(--text-muted)' }}>Instructor-led simulation</p>
                            </div>
                          </div>
                          
                          <div style={{ display: 'flex', alignItems: 'center', gap: '24px' }}>
                            <div style={{ textAlign: 'right' }}>
                              <p style={{ fontSize: '0.9rem', fontWeight: 600, color: isSuccess ? 'var(--success)' : isFull ? 'var(--danger)' : 'var(--success)' }}>
                                {isSuccess ? 'Your Spot Secured' : isFull ? 'Session Full' : `${block.total - block.booked} seats left`}
                              </p>
                              {!isSuccess && (
                                <div style={{ width: '100px', height: '4px', background: 'var(--border)', borderRadius: '2px', marginTop: '6px', overflow: 'hidden' }}>
                                  <div style={{ width: `${(block.booked / block.total) * 100}%`, height: '100%', background: isFull ? 'var(--danger)' : 'var(--success)' }} />
                                </div>
                              )}
                            </div>
                            <button 
                              className={`btn ${isSuccess ? 'btn-success' : isFull ? 'btn-secondary' : 'btn-primary'}`}
                              style={{ padding: '8px 24px', width: '140px', opacity: isFull && !isSuccess ? 0.6 : 1, background: isSuccess ? 'var(--success)' : undefined, color: isSuccess ? '#fff' : undefined }}
                              disabled={isFull || isLoading || isSuccess}
                              onClick={() => handleBook(session.id, block.time)}
                            >
                              {isLoading ? <div className="spinner" style={{width: '16px', height: '16px', borderWidth: '2px', borderColor: '#fff', borderTopColor: 'transparent'}}/> : isSuccess ? 'Booked' : isFull ? 'Waitlist' : 'Book Session'}
                            </button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          )}

        </div>
      </div>
    </div>
  );
}
</file>

<file path="app/practitioners/page.js">
"use client";
import { useState, useEffect } from 'react';
import { Award, Search, ShieldCheck, MapPin } from 'lucide-react';
import { collection, getDocs, query, where } from 'firebase/firestore';
import { db } from '../../lib/firebase';
import { useAuth } from '../../components/AuthProvider';

export default function PractitionersDirectory() {
  const [practitioners, setPractitioners] = useState([]);
  const [loading, setLoading] = useState(true);
  const [searchTerm, setSearchTerm] = useState('');

  useEffect(() => {
    async function fetchPublicProfiles() {
      try {
        const q = query(collection(db, 'users'), where('isPublic', '==', true));
        const snapshot = await getDocs(q);
        const fetched = [];
        snapshot.forEach(doc => {
          fetched.push({ id: doc.id, ...doc.data() });
        });
        
        setPractitioners(fetched);
      } catch (err) {
        console.error(err);
      } finally {
        setLoading(false);
      }
    }
    fetchPublicProfiles();
  }, []);

  const filtered = practitioners.filter(p => p.name?.toLowerCase().includes(searchTerm.toLowerCase()) || p.role?.toLowerCase().includes(searchTerm.toLowerCase()));

  return (
    <div className="animate-fade-in" style={{ paddingBottom: '60px' }}>
      <header style={{ textAlign: 'center', marginBottom: '40px', maxWidth: '800px', margin: '0 auto 40px' }}>
        <h1 style={{ fontSize: '2.5rem', marginBottom: '16px' }}>Public Practitioner Directory</h1>
        <p style={{ color: 'var(--text-muted)', fontSize: '1.1rem' }}>Find verified medical professionals with certified CPD points and specialized training on the Pamoja platform.</p>
        
        <div className="input-group" style={{ position: 'relative', marginTop: '32px', maxWidth: '500px', margin: '32px auto 0' }}>
          <Search size={20} style={{ position: 'absolute', left: '16px', top: '16px', color: 'var(--text-muted)' }} />
          <input 
            type="text" 
            placeholder="Search by name, role, or specialty..." 
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            style={{ paddingLeft: '48px', fontSize: '1.1rem', borderRadius: '40px' }} 
          />
        </div>
      </header>

      {loading ? (
        <div style={{ textAlign: 'center', padding: '60px' }}><div className="spinner"></div></div>
      ) : filtered.length === 0 ? (
        <div style={{ textAlign: 'center', padding: '60px', color: 'var(--text-muted)' }}>
          <h3>No public practitioners found.</h3>
          <p>Be the first to make your portfolio public from your Profile page!</p>
        </div>
      ) : (
        <div className="grid-3">
          {filtered.map(p => (
            <div key={p.id} className="glass-card" style={{ textAlign: 'center', padding: '32px', position: 'relative' }}>
              <img 
                src={p.photoURL || `https://ui-avatars.com/api/?name=${p.name}&background=00b4d8&color=fff`}
                alt={p.name}
                style={{ width: '100px', height: '100px', borderRadius: '50%', objectFit: 'cover', margin: '0 auto 16px', border: '3px solid var(--surface-hover)' }}
              />
              <h3 style={{ fontSize: '1.25rem', marginBottom: '4px' }}>{p.name}</h3>
              <p style={{ color: 'var(--text-muted)', fontSize: '0.9rem', marginBottom: '16px' }}>{p.role || 'Verified Practitioner'}</p>
              
              {p.location && (
                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '4px', color: 'var(--text-muted)', fontSize: '0.85rem', marginBottom: '16px' }}>
                  <MapPin size={14} /> {p.location}
                </div>
              )}

              <div style={{ display: 'flex', justifyContent: 'center', gap: '16px', marginBottom: '24px', borderTop: '1px solid var(--border)', borderBottom: '1px solid var(--border)', padding: '12px 0' }}>
                <div style={{ textAlign: 'center' }}>
                  <div style={{ fontWeight: 'bold', fontSize: '1.2rem', color: 'var(--primary)' }}>{p.cpdPoints || 0}</div>
                  <div style={{ fontSize: '0.75rem', color: 'var(--text-muted)', textTransform: 'uppercase' }}>CPD Points</div>
                </div>
                <div style={{ width: '1px', background: 'var(--border)' }}></div>
                <div style={{ textAlign: 'center' }}>
                  <div style={{ fontWeight: 'bold', fontSize: '1.2rem', color: 'var(--success)' }}>{p.badges?.length || 0}</div>
                  <div style={{ fontSize: '0.75rem', color: 'var(--text-muted)', textTransform: 'uppercase' }}>Badges</div>
                </div>
              </div>

              <button className="btn btn-primary" style={{ width: '100%', justifyContent: 'center' }}>View Full Profile</button>
            </div>
          ))}
