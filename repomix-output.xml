<file path="components/AIAssistant.js">
"use client";
import { useState, useEffect, useRef } from 'react';
import { useAuth } from './AuthProvider';
import { Bot, X, Sparkles, Target, Zap, ChevronRight, Award, User } from 'lucide-react';
import Link from 'next/link';
import { doc, setDoc } from 'firebase/firestore';
import { db } from '../lib/firebase';

export default function AIAssistant() {
  const { user, profile } = useAuth();
  const [isOpen, setIsOpen] = useState(false);
  const [showTooltip, setShowTooltip] = useState(false);
  const [input, setInput] = useState('');
  const [challengeAccepted, setChallengeAccepted] = useState(false);
  const [messages, setMessages] = useState([
    { type: 'bot', text: 'Hi there! Based on your recent progress, I\'ve curated a personalized learning path for you.' }
  ]);
  const chatEndRef = useRef(null);

  useEffect(() => {
    if (user) {
      setTimeout(() => setShowTooltip(true), 3000);
    } else {
      setIsOpen(false);
      setShowTooltip(false);
    }
  }, [user]);

  useEffect(() => {
    if (isOpen) {
      chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
    }
  }, [messages, isOpen, challengeAccepted]);

  if (!user) return null;

  const handleSend = () => {
    if (!input.trim()) return;
    const userMsg = input.trim();
    setInput('');
    setMessages(prev => [...prev, { type: 'user', text: userMsg }]);
    
    // Mock AI response logic
    setTimeout(() => {
      let botResponse = "That's an interesting question! For now, focus on your pending labs.";
      if (userMsg.toLowerCase().includes('points') || userMsg.toLowerCase().includes('cpd')) {
        botResponse = "You can earn CPD points by completing the verified modules in your dashboard or attending practical labs.";
      } else if (userMsg.toLowerCase().includes('hello') || userMsg.toLowerCase().includes('hi')) {
        botResponse = "Hello! Ready to continue your medical training today?";
      } else if (userMsg.toLowerCase().includes('course')) {
        botResponse = "I highly recommend the Advanced PPH Intervention Masterclass based on your profile.";
      }
      setMessages(prev => [...prev, { type: 'bot', text: botResponse }]);
    }, 1000);
  };

  const handleAcceptChallenge = async () => {
    setChallengeAccepted(true);
    
    // Add XP and Notification to user profile in Firebase
    if (user && profile) {
      const newPoints = (profile.cpdPoints || 0) + 0.5;
      const newNotif = { id: Date.now().toString(), text: "Earned +0.5 CPD Points from AI Challenge", time: "Just now", read: false };
      const currentNotifs = profile.notifications || [];
      const userRef = doc(db, 'users', user.uid);
      await setDoc(userRef, { cpdPoints: newPoints, notifications: [...currentNotifs, newNotif] }, { merge: true });
    }

    setMessages(prev => [...prev, { type: 'bot', text: 'Awesome! I have awarded you +0.5 Bonus Points for accepting the challenge! Keep up the great work.' }]);
  };

  return (
    <div style={{ position: 'fixed', bottom: '24px', right: '24px', zIndex: 100, display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: '16px' }}>
      
      {showTooltip && !isOpen && (
        <div className="glass-card animate-fade-in" style={{ padding: '16px', border: '1px solid var(--primary)', background: 'rgba(3, 4, 94, 0.95)', color: '#fff', borderRadius: '12px 12px 0 12px', position: 'relative' }}>
          <button onClick={() => setShowTooltip(false)} style={{ position: 'absolute', top: '8px', right: '8px', background: 'none', border: 'none', color: '#fff', cursor: 'pointer', opacity: 0.7 }}>
            <X size={14} />
          </button>
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '8px', fontWeight: 600 }}>
            <Sparkles size={16} color="var(--primary)" />
            <span>AI Mentor Tip!</span>
          </div>
          <p style={{ fontSize: '0.9rem', maxWidth: '200px', lineHeight: 1.4, color: 'rgba(255,255,255,0.8)' }}>
            Complete the <b>Neonatology</b> module today to earn a <b>+50 XP Bonus</b>!
          </p>
        </div>
      )}

      {isOpen && (
        <div className="glass-card animate-fade-in" style={{ width: '380px', height: '600px', display: 'flex', flexDirection: 'column', borderRadius: 'var(--radius-lg)', overflow: 'hidden', boxShadow: '0 10px 40px rgba(0,0,0,0.2)' }}>
          <div style={{ background: 'var(--primary)', color: '#fff', padding: '16px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
              <div style={{ width: '36px', height: '36px', background: 'rgba(255,255,255,0.2)', borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                <Bot size={20} />
              </div>
              <div>
                <h3 style={{ fontSize: '1.1rem', margin: 0 }}>Pamoja AI Mentor</h3>
                <p style={{ fontSize: '0.75rem', opacity: 0.8, margin: 0 }}>Always here to guide you</p>
              </div>
            </div>
            <button onClick={() => setIsOpen(false)} style={{ background: 'none', border: 'none', color: '#fff', cursor: 'pointer' }}>
              <X size={24} />
            </button>
          </div>

          <div style={{ flex: 1, padding: '16px', overflowY: 'auto', display: 'flex', flexDirection: 'column', gap: '16px', background: 'var(--background)' }}>
            
            {/* Initial Dynamic Content Widget */}
            <div style={{ alignSelf: 'center', background: 'rgba(0,180,216,0.05)', padding: '16px', borderRadius: 'var(--radius-md)', width: '100%', border: '1px solid rgba(0,180,216,0.2)' }}>
              <h4 style={{ fontSize: '0.9rem', marginBottom: '12px', display: 'flex', alignItems: 'center', gap: '6px', color: 'var(--primary)' }}>
                <Target size={16} /> Recommended Next Steps
              </h4>
              <Link href="/courses/1" style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', background: 'var(--surface)', padding: '12px', borderRadius: 'var(--radius-sm)', marginBottom: '8px', textDecoration: 'none', color: 'inherit', border: '1px solid var(--border)' }}>
                <div><p style={{ fontSize: '0.85rem', fontWeight: 600 }}>1. Complete Module 3</p><p style={{ fontSize: '0.75rem', color: 'var(--text-muted)' }}>Advanced PPH Intervention</p></div>
                <ChevronRight size={16} color="var(--text-muted)" />
              </Link>
              <Link href="/labs" style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', background: 'var(--surface)', padding: '12px', borderRadius: 'var(--radius-sm)', textDecoration: 'none', color: 'inherit', border: '1px solid var(--border)' }}>
                <div><p style={{ fontSize: '0.85rem', fontWeight: 600 }}>2. Book Practical Lab</p><p style={{ fontSize: '0.75rem', color: 'var(--text-muted)' }}>Required for certification</p></div>
                <ChevronRight size={16} color="var(--text-muted)" />
              </Link>
            </div>

            {!challengeAccepted && (
              <div className="animate-fade-in" style={{ alignSelf: 'center', background: 'rgba(255, 183, 3, 0.1)', padding: '16px', borderRadius: 'var(--radius-md)', width: '100%', border: '1px solid rgba(255, 183, 3, 0.3)' }}>
                <h4 style={{ fontSize: '0.9rem', marginBottom: '8px', display: 'flex', alignItems: 'center', gap: '6px', color: '#fb8500' }}>
                  <Zap size={16} /> Daily Challenge
                </h4>
                <p style={{ fontSize: '0.85rem', marginBottom: '12px', color: 'var(--text-main)' }}>Pass the Neonatology knowledge check quiz today to earn +0.5 Bonus Points.</p>
                <button onClick={handleAcceptChallenge} className="btn" style={{ background: '#ffb703', color: '#000', width: '100%', justifyContent: 'center', padding: '8px', fontSize: '0.85rem', border: 'none', cursor: 'pointer' }}>
                  <Award size={16} style={{marginRight: '6px'}}/> Accept Challenge
                </button>
              </div>
            )}

            {/* Chat Messages */}
            {messages.map((msg, i) => (
              <div key={i} style={{ display: 'flex', gap: '8px', alignSelf: msg.type === 'user' ? 'flex-end' : 'flex-start', maxWidth: '85%' }}>
                {msg.type === 'bot' && (
                  <div style={{ width: '28px', height: '28px', background: 'var(--primary)', borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#fff', flexShrink: 0, marginTop: '4px' }}>
                    <Bot size={14} />
                  </div>
                )}
                <div style={{ 
                  background: msg.type === 'user' ? 'var(--primary)' : 'var(--surface)', 
                  color: msg.type === 'user' ? '#fff' : 'var(--text-main)',
                  padding: '12px 16px', 
                  borderRadius: msg.type === 'user' ? '16px 16px 0 16px' : '16px 16px 16px 0', 
                  border: msg.type === 'user' ? 'none' : '1px solid var(--border)',
                  fontSize: '0.9rem',
                  lineHeight: 1.5
                }}>
                  {msg.text}
                </div>
              </div>
            ))}
            
            <div ref={chatEndRef} />
          </div>

          <div style={{ padding: '16px', borderTop: '1px solid var(--border)', background: 'var(--surface)' }}>
            <div className="input-group" style={{ marginBottom: 0, position: 'relative' }}>
              <input 
                type="text" 
                placeholder="Ask me anything..." 
                value={input}
                onChange={(e) => setInput(e.target.value)}
                onKeyDown={(e) => e.key === 'Enter' && handleSend()}
                style={{ paddingRight: '40px', background: 'var(--background)' }} 
              />
              <button onClick={handleSend} style={{ position: 'absolute', right: '8px', top: '8px', background: 'var(--primary)', border: 'none', width: '24px', height: '24px', borderRadius: '50%', color: '#fff', display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer' }}>
                <ChevronRight size={14} />
              </button>
            </div>
          </div>
        </div>
      )}

      <button 
        onClick={() => { setIsOpen(!isOpen); setShowTooltip(false); }} 
        style={{ width: '60px', height: '60px', borderRadius: '50%', background: 'var(--primary)', color: '#fff', border: 'none', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', boxShadow: '0 4px 20px rgba(0, 180, 216, 0.4)', transition: 'transform 0.2s' }}
        onMouseOver={(e) => e.currentTarget.style.transform = 'scale(1.1)'}
        onMouseOut={(e) => e.currentTarget.style.transform = 'scale(1)'}
      >
        {isOpen ? <X size={28} /> : <Bot size={28} />}
      </button>
    </div>
  );
}
