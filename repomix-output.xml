            </div>
          ) : (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
              {sessionsForDate.map((session, idx) => (
                <div key={session.id} className={`glass-card delay-${idx + 1} animate-fade-in`} style={{ padding: '24px', display: 'flex', flexDirection: 'column', gap: '20px', position: 'relative', overflow: 'hidden' }}>
