          <p style={{ fontSize: '1.2rem', color: '#64748b', marginBottom: '40px', maxWidth: '600px', margin: '0 auto 40px' }}>
            Discover top medical and professional courses taught by industry experts.
          </p>
          
          <div style={{ display: 'flex', maxWidth: '600px', margin: '0 auto', position: 'relative' }}>
            <input 
              type="text" 
              placeholder="What do you want to learn?"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              style={{ width: '100%', padding: '16px 24px', fontSize: '1rem', borderRadius: 'var(--radius-full)', border: '1px solid var(--border)', background: '#fff', boxShadow: '0 10px 30px rgba(0,0,0,0.05)' }}
            />
            <button className="btn btn-primary" style={{ position: 'absolute', right: '6px', top: '6px', bottom: '6px', borderRadius: 'var(--radius-full)', padding: '0 24px' }}>
