            <Award size={32} color="var(--primary)" style={{ margin: '0 auto 8px' }}/>
            <h4 style={{ fontSize: '1.5rem', color: '#0f172a' }}>1,500+</h4>
            <p style={{ color: '#64748b', fontSize: '0.9rem' }}>Students Enrolled</p>
          </div>
          <div style={{ textAlign: 'center' }}>
            <Target size={32} color="var(--primary)" style={{ margin: '0 auto 8px' }}/>
            <h4 style={{ fontSize: '1.5rem', color: '#0f172a' }}>12,000</h4>
            <p style={{ color: '#64748b', fontSize: '0.9rem' }}>Classes Completed</p>
          </div>
          <div style={{ textAlign: 'center' }}>
            <Shield size={32} color="var(--primary)" style={{ margin: '0 auto 8px' }}/>
