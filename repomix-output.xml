<file path="app/studio/page.js">
"use client";
import { useState, useEffect } from 'react';
import { useAuth } from '../../components/AuthProvider';
import { PlusCircle, Video, FileText, Settings, ShieldCheck, CheckCircle, Edit3, Trash2, Save, X, Users, Image as ImageIcon, Check, Plus, GripVertical } from 'lucide-react';
import { collection, getDocs, doc, setDoc, deleteDoc, query, onSnapshot, serverTimestamp } from 'firebase/firestore';
import { db } from '../../lib/firebase';

export default function EducatorStudio() {
  const { user, profile, loginWithGoogle } = useAuth();
  const [activeTab, setActiveTab] = useState('courses');
  
  // Data State
  const [courses, setCourses] = useState([]);
  const [loading, setLoading] = useState(true);
  
  // Real-time listener for courses
  useEffect(() => {
    if (!user || !profile) return;
    const q = query(collection(db, 'courses'));
    const unsubscribe = onSnapshot(q, (snapshot) => {
      const fetchedCourses = [];
      snapshot.forEach(doc => fetchedCourses.push({ id: doc.id, ...doc.data() }));
      setCourses(fetchedCourses);
      setLoading(false);
    });
    return () => unsubscribe();
  }, [user, profile]);

  const [mockUsers, setMockUsers] = useState([
    { id: '1', name: 'Alice Smith', email: 'alice@example.com', role: 'learner', status: 'Active' },
    { id: '2', name: 'Bob Jones', email: 'bob@example.com', role: 'creator', status: 'Active' }
  ]);

  // Editor State
  const [editingId, setEditingId] = useState(null);
  const [editForm, setEditForm] = useState({});
  const [isCreating, setIsCreating] = useState(false);
  const [imgError, setImgError] = useState(false);

  if (!user || !profile || (profile.role !== 'creator' && profile.role !== 'superuser')) {
    return (
      <div style={{ textAlign: 'center', padding: '80px 20px', maxWidth: '700px', margin: '0 auto' }} className="animate-fade-in">
        <div style={{ background: '#fff', borderRadius: 'var(--radius-lg)', padding: '60px 40px', boxShadow: '0 10px 40px rgba(0,0,0,0.05)', border: '1px solid #f1f5f9' }}>
          <div style={{ width: '80px', height: '80px', borderRadius: '50%', background: 'rgba(0,180,216,0.1)', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 24px' }}>
            <Users size={40} color="var(--primary)" />
          </div>
          <h2 style={{ fontSize: '2.5rem', marginBottom: '16px', color: '#0f172a', fontWeight: 700 }}>Become an Educator</h2>
          <p style={{ color: '#64748b', fontSize: '1.1rem', marginBottom: '40px', lineHeight: 1.6 }}>
            Join our network of healthcare professionals and share your expertise. Create courses, manage simulation labs, and empower the next generation of medical practitioners.
          </p>
          
          <div style={{ display: 'flex', gap: '16px', justifyContent: 'center' }}>
            {!user ? (
              <button onClick={() => {
                // Because loginWithGoogle isn't exposed in this scope yet, we need to get it from useAuth
                // Wait, useAuth gives us user, profile... we didn't destructure loginWithGoogle!
                // We must ensure loginWithGoogle is destructured from useAuth.
                loginWithGoogle();
              }} className="btn btn-primary" style={{ padding: '16px 32px', fontSize: '1.1rem' }}>
                Sign In to Apply
              </button>
            ) : (
              <button className="btn btn-primary" style={{ padding: '16px 32px', fontSize: '1.1rem' }}>
                Apply for Creator Access
              </button>
            )}
            <button className="btn btn-secondary" style={{ padding: '16px 32px', fontSize: '1.1rem', background: '#f8fafc' }}>
              Learn More
            </button>
          </div>
        </div>
      </div>
    );
  }

  const isSuperuser = profile.role === 'superuser';
  const displayedCourses = isSuperuser ? courses : courses.filter(c => c.creatorId === user?.uid);


  const handleStartEdit = (course) => {
    setEditingId(course.id);
    setEditForm({
      ...course,
      modules: course.modules || []
    });
    setIsCreating(false);
    setImgError(false);
  };

  const handleStartCreate = () => {
    setIsCreating(true);
    setEditingId(null);
    setImgError(false);
    setEditForm({
      title: "",
      description: "",
      duration: "",
      cpd: "",
      category: "Maternal Health",
      image: "",
      videoUrl: "",
      status: "Draft",
      creatorId: user.uid,
      modules: []
    });
  };

  const handleSave = async () => {
    const finalForm = { ...editForm, status: editForm.status === 'Draft' ? 'Pending Approval' : editForm.status, updatedAt: serverTimestamp() };
    if (isCreating) {
      finalForm.createdAt = serverTimestamp();
      const newRef = doc(collection(db, 'courses'));
      await setDoc(newRef, finalForm);
    } else {
      await setDoc(doc(db, 'courses', String(editingId)), finalForm, { merge: true });
    }
    setEditingId(null);
    setIsCreating(false);
  };

  const handleDelete = async (id) => {
    if (window.confirm("Delete this course permanently?")) {
      await deleteDoc(doc(db, 'courses', id));
    }
  };

  const handleApprove = async (id) => {
    await setDoc(doc(db, 'courses', id), { status: 'Published' }, { merge: true });
  };

  const handleSuspendUser = (id) => {
    setMockUsers(mockUsers.map(u => u.id === id ? { ...u, status: u.status === 'Active' ? 'Suspended' : 'Active' } : u));
  };

  const handleChange = (e) => setEditForm({ ...editForm, [e.target.name]: e.target.value });

  // Hierarchical State Handlers
  const addModule = () => {
    setEditForm({ ...editForm, modules: [...(editForm.modules || []), { id: Date.now().toString(), title: "New Module", topics: [] }] });
  };
  const updateModuleTitle = (modIdx, value) => {
    const mods = [...editForm.modules];
    mods[modIdx].title = value;
    setEditForm({ ...editForm, modules: mods });
  };
  const removeModule = (modIdx) => {
    setEditForm({ ...editForm, modules: editForm.modules.filter((_, i) => i !== modIdx) });
  };

  const addTopic = (modIdx) => {
    const mods = [...editForm.modules];
    mods[modIdx].topics.push({ id: Date.now().toString(), title: "New Topic", content: "", resources: [] });
    setEditForm({ ...editForm, modules: mods });
  };
  const updateTopic = (modIdx, topIdx, field, value) => {
    const mods = [...editForm.modules];
    mods[modIdx].topics[topIdx][field] = value;
    setEditForm({ ...editForm, modules: mods });
  };
  const removeTopic = (modIdx, topIdx) => {
    const mods = [...editForm.modules];
    mods[modIdx].topics.splice(topIdx, 1);
    setEditForm({ ...editForm, modules: mods });
  };

  const addResource = (modIdx, topIdx) => {
    const mods = [...editForm.modules];
    mods[modIdx].topics[topIdx].resources.push({ id: Date.now().toString(), title: "New Resource", type: "pdf", url: "" });
    setEditForm({ ...editForm, modules: mods });
  };
  const updateResource = (modIdx, topIdx, resIdx, field, value) => {
    const mods = [...editForm.modules];
    mods[modIdx].topics[topIdx].resources[resIdx][field] = value;
    setEditForm({ ...editForm, modules: mods });
  };
  const removeResource = (modIdx, topIdx, resIdx) => {
    const mods = [...editForm.modules];
    mods[modIdx].topics[topIdx].resources.splice(resIdx, 1);
    setEditForm({ ...editForm, modules: mods });
  };

  return (
    <div className="animate-fade-in" style={{ display: 'flex', gap: '40px', paddingBottom: '80px' }}>
      <aside style={{ width: '250px', display: 'flex', flexDirection: 'column', gap: '8px', flexShrink: 0 }}>
        <h3 style={{ fontSize: '0.85rem', textTransform: 'uppercase', color: 'var(--text-muted)', letterSpacing: '1px', marginBottom: '16px', paddingLeft: '16px' }}>My Studio</h3>
        <button onClick={() => setActiveTab('courses')} className={`btn ${activeTab === 'courses' ? 'btn-primary' : ''}`} style={{ justifyContent: 'flex-start', background: activeTab === 'courses' ? '' : 'transparent', color: activeTab === 'courses' ? '#fff' : 'var(--text-main)', boxShadow: 'none' }}><Video size={18} /> My Courses</button>
        <button onClick={() => setActiveTab('resources')} className={`btn ${activeTab === 'resources' ? 'btn-primary' : ''}`} style={{ justifyContent: 'flex-start', background: activeTab === 'resources' ? '' : 'transparent', color: activeTab === 'resources' ? '#fff' : 'var(--text-main)', boxShadow: 'none' }}><FileText size={18} /> Asset Library</button>

        {isSuperuser && (
          <>
            <h3 style={{ fontSize: '0.85rem', textTransform: 'uppercase', color: 'var(--text-muted)', letterSpacing: '1px', margin: '24px 0 16px', paddingLeft: '16px' }}>Superuser Admin</h3>
            <button onClick={() => setActiveTab('admin_courses')} className={`btn ${activeTab === 'admin_courses' ? 'btn-primary' : ''}`} style={{ justifyContent: 'flex-start', background: activeTab === 'admin_courses' ? '' : 'transparent', color: activeTab === 'admin_courses' ? '#fff' : 'var(--text-main)', boxShadow: 'none' }}><ShieldCheck size={18} /> Global Approvals</button>
            <button onClick={() => setActiveTab('admin_users')} className={`btn ${activeTab === 'admin_users' ? 'btn-primary' : ''}`} style={{ justifyContent: 'flex-start', background: activeTab === 'admin_users' ? '' : 'transparent', color: activeTab === 'admin_users' ? '#fff' : 'var(--text-main)', boxShadow: 'none' }}><Users size={18} /> User Management</button>
          </>
        )}
      </aside>

      <div style={{ flex: 1, minWidth: 0 }}>
        <header style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '40px', borderBottom: '1px solid var(--border)', paddingBottom: '24px' }}>
          <div>
            <h1 style={{ fontSize: '2rem', marginBottom: '8px' }}>
              {activeTab === 'admin_courses' ? 'Global Course Approvals' : activeTab === 'admin_users' ? 'Platform Users' : 'Course Manager'}
            </h1>
            <p style={{ color: 'var(--text-muted)' }}>
              {activeTab === 'admin_courses' ? 'Review, approve, or reject courses submitted by creators.' : activeTab === 'admin_users' ? 'Manage roles, suspend accounts, and resolve disputes.' : 'Draft, build, and publish your educational content hierarchically.'}
            </p>
          </div>
          {activeTab === 'courses' && !isCreating && !editingId && (
            <button className="btn btn-primary" onClick={handleStartCreate} style={{ padding: '12px 24px' }}>
              <PlusCircle size={20} /> Create Course
            </button>
          )}
        </header>

        {loading ? (
          <div style={{ textAlign: 'center', padding: '60px' }}><div className="spinner"></div></div>
        ) : activeTab === 'admin_users' && isSuperuser ? (
          <div className="glass-card" style={{ overflow: 'hidden' }}>
            <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left' }}>
              <thead>
                <tr style={{ background: 'var(--surface-hover)', borderBottom: '1px solid var(--border)' }}>
                  <th style={{ padding: '16px' }}>Name / Email</th><th style={{ padding: '16px' }}>Role</th><th style={{ padding: '16px' }}>Status</th><th style={{ padding: '16px' }}>Actions</th>
                </tr>
              </thead>
              <tbody>
                {mockUsers.map(u => (
                  <tr key={u.id} style={{ borderBottom: '1px solid var(--border)' }}>
                    <td style={{ padding: '16px' }}><div style={{ fontWeight: 600 }}>{u.name}</div><div style={{ fontSize: '0.85rem', color: 'var(--text-muted)' }}>{u.email}</div></td>
                    <td style={{ padding: '16px' }}><span className="badge badge-warning">{u.role}</span></td>
                    <td style={{ padding: '16px' }}><span className={`badge ${u.status === 'Active' ? 'badge-success' : 'badge-primary'}`} style={{ background: u.status === 'Suspended' ? 'var(--danger)' : undefined }}>{u.status}</span></td>
                    <td style={{ padding: '16px' }}><button onClick={() => handleSuspendUser(u.id)} className="btn btn-secondary">{u.status === 'Active' ? 'Suspend' : 'Activate'}</button></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (editingId || isCreating) ? (
          <section className="glass-card animate-fade-in" style={{ padding: '32px', marginBottom: '40px', border: '1px solid var(--primary)' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: '24px' }}>
              <h2 style={{ fontSize: '1.5rem', display: 'flex', alignItems: 'center', gap: '8px' }}><Edit3 size={24} color="var(--primary)" /> {isCreating ? 'Create New Course' : 'Course Builder'}</h2>
              <div className={`badge ${editForm.status === 'Published' ? 'badge-success' : 'badge-warning'}`}>{editForm.status || 'Draft'}</div>
            </div>

            <div className="grid-2" style={{ marginBottom: '32px', gap: '24px' }}>
              <div className="input-group" style={{ gridColumn: '1 / -1' }}><label>Course Title</label><input type="text" name="title" value={editForm.title || ''} onChange={handleChange} placeholder="e.g. Advanced PPH Intervention" style={{ fontSize: '1.2rem', padding: '12px' }} /></div>
              <div className="input-group" style={{ gridColumn: '1 / -1' }}>
                <label>Header Image URL</label>
                <input type="text" name="image" value={editForm.image || ''} onChange={(e) => { handleChange(e); setImgError(false); }} placeholder="https://images.unsplash.com/..." />
                <div style={{ marginTop: '12px', height: '160px', width: '100%', borderRadius: 'var(--radius-md)', border: '1px dashed var(--border)', display: 'flex', alignItems: 'center', justifyContent: 'center', overflow: 'hidden', background: 'var(--surface)' }}>
                  {editForm.image && !imgError ? <img src={editForm.image} alt="Preview" onError={() => setImgError(true)} style={{ width: '100%', height: '100%', objectFit: 'cover' }} /> : <div style={{ color: 'var(--text-muted)', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '8px' }}><ImageIcon size={32} /><span>{imgError ? 'Image failed to load' : 'Image Preview'}</span></div>}
                </div>
              </div>
              <div className="input-group"><label>Category</label><input type="text" name="category" value={editForm.category || ''} onChange={handleChange} /></div>
              <div className="input-group"><label>Demo Video URL</label><input type="text" name="videoUrl" value={editForm.videoUrl || ''} onChange={handleChange} /></div>
              <div className="input-group"><label>Total Duration</label><input type="text" name="duration" value={editForm.duration || ''} onChange={handleChange} /></div>
              <div className="input-group"><label>CPD Points</label><input type="text" name="cpd" value={editForm.cpd || ''} onChange={handleChange} /></div>
              <div className="input-group" style={{ gridColumn: '1 / -1' }}>
                <label>Course Description</label>
                <textarea name="description" value={editForm.description || ''} onChange={handleChange} style={{ width: '100%', padding: '12px 16px', borderRadius: 'var(--radius-md)', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text-main)', fontFamily: 'var(--font-base)', minHeight: '120px' }} />
              </div>
            </div>

            {/* DEEP HIERARCHICAL BUILDER */}
            <div style={{ borderTop: '1px solid var(--border)', paddingTop: '32px', marginBottom: '32px' }}>
              <h3 style={{ fontSize: '1.25rem', marginBottom: '16px', display: 'flex', alignItems: 'center', gap: '8px' }}><FileText size={20} color="var(--primary)" /> Course Content Structure</h3>
              <p style={{ color: 'var(--text-muted)', marginBottom: '24px' }}>Build your course out infinitely: Modules &rarr; Topics &rarr; Rich Text Content & Resources.</p>

              <div style={{ display: 'flex', flexDirection: 'column', gap: '32px', marginBottom: '24px' }}>
                {editForm.modules?.map((mod, mIdx) => (
                  <div key={mod.id || mIdx} style={{ background: 'rgba(255,255,255,0.02)', border: '1px solid var(--border)', borderRadius: 'var(--radius-md)', padding: '24px', position: 'relative' }}>
                    <button onClick={() => removeModule(mIdx)} style={{ position: 'absolute', top: '24px', right: '24px', background: 'none', border: 'none', color: 'var(--danger)', cursor: 'pointer' }}><Trash2 size={18} /></button>
                    
                    <div className="input-group">
                      <label style={{ fontSize: '0.9rem', color: 'var(--primary)', fontWeight: 600 }}>MODULE {mIdx + 1} TITLE</label>
                      <input type="text" value={mod.title || ''} onChange={(e) => updateModuleTitle(mIdx, e.target.value)} style={{ padding: '12px', fontSize: '1.1rem', fontWeight: 600 }} placeholder="e.g. Introduction to Protocols" />
                    </div>

                    <div style={{ display: 'flex', flexDirection: 'column', gap: '16px', marginTop: '24px', marginLeft: '24px', borderLeft: '2px solid var(--border)', paddingLeft: '24px' }}>
                      {mod.topics?.map((topic, tIdx) => (
                        <div key={topic.id || tIdx} style={{ background: 'var(--surface)', border: '1px solid var(--border)', borderRadius: 'var(--radius-sm)', padding: '16px', position: 'relative' }}>
                          <button onClick={() => removeTopic(mIdx, tIdx)} style={{ position: 'absolute', top: '16px', right: '16px', background: 'none', border: 'none', color: 'var(--text-muted)', cursor: 'pointer' }}><X size={16} /></button>
                          
                          <div className="input-group" style={{ marginBottom: '16px' }}>
                            <label style={{ fontSize: '0.8rem', fontWeight: 600 }}>TOPIC TITLE</label>
                            <input type="text" value={topic.title || ''} onChange={(e) => updateTopic(mIdx, tIdx, 'title', e.target.value)} style={{ padding: '8px' }} placeholder="e.g. The first 5 minutes" />
                          </div>

                          <div className="input-group" style={{ marginBottom: '16px' }}>
                            <label style={{ fontSize: '0.8rem', fontWeight: 600 }}>RICH TEXT CONTENT</label>
                            <textarea value={topic.content || ''} onChange={(e) => updateTopic(mIdx, tIdx, 'content', e.target.value)} style={{ width: '100%', padding: '12px', minHeight: '120px', borderRadius: '4px', background: 'var(--background)', color: 'var(--text-main)', border: '1px solid var(--border)' }} placeholder="Add formatted text, instructions, and teaching notes here..." />
                          </div>

                          <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', marginBottom: '16px' }}>
                            {topic.resources?.map((res, rIdx) => (
                              <div key={res.id || rIdx} style={{ display: 'flex', gap: '8px', alignItems: 'center' }}>
                                <GripVertical size={14} color="var(--text-muted)" />
                                <select value={res.type || 'video'} onChange={(e) => updateResource(mIdx, tIdx, rIdx, 'type', e.target.value)} style={{ padding: '6px', fontSize: '0.8rem' }}>
                                  <option value="video">Video</option>
                                  <option value="pdf">PDF</option>
                                  <option value="audio">Audio</option>
                                </select>
                                <input type="text" value={res.title || ''} onChange={(e) => updateResource(mIdx, tIdx, rIdx, 'title', e.target.value)} placeholder="Resource Title" style={{ padding: '6px', fontSize: '0.8rem', flex: 1 }} />
                                <input type="text" value={res.url || ''} onChange={(e) => updateResource(mIdx, tIdx, rIdx, 'url', e.target.value)} placeholder="URL link..." style={{ padding: '6px', fontSize: '0.8rem', flex: 2 }} />
                                <button onClick={() => removeResource(mIdx, tIdx, rIdx)} style={{ background: 'none', border: 'none', color: 'var(--danger)', cursor: 'pointer' }}><X size={14}/></button>
                              </div>
                            ))}
                          </div>

                          <button className="btn btn-secondary" onClick={() => addResource(mIdx, tIdx)} style={{ padding: '6px 12px', fontSize: '0.8rem' }}><Plus size={14}/> Add Resource</button>
                        </div>
                      ))}
                      <button className="btn btn-secondary" onClick={() => addTopic(mIdx)} style={{ alignSelf: 'flex-start', borderStyle: 'dashed' }}><PlusCircle size={16} /> Add Topic</button>
                    </div>
                  </div>
                ))}
              </div>

              <button className="btn btn-primary" onClick={addModule} style={{ width: '100%', justifyContent: 'center', padding: '16px', background: 'rgba(0,180,216,0.1)', color: 'var(--primary)' }}><PlusCircle size={20} /> Add New Module</button>
            </div>

            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '16px', borderTop: '1px solid var(--border)', paddingTop: '24px' }}>
              <button className="btn btn-secondary" onClick={() => {setEditingId(null); setIsCreating(false);}}><X size={20} /> Cancel</button>
              <button className="btn btn-primary" onClick={handleSave}><Save size={20} /> {isCreating ? 'Save & Submit' : 'Save Changes'}</button>
            </div>
          </section>
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
            {displayedCourses.length === 0 && courses.length === 0 && isSuperuser && (
              <div style={{ textAlign: 'center', padding: '40px', background: 'rgba(255, 183, 3, 0.1)', borderRadius: 'var(--radius-md)', border: '1px dashed #ffb703', marginBottom: '24px' }}>
                <p style={{ color: '#fb8500', marginBottom: '16px' }}>Database is empty.</p>
              </div>
            )}
            
            {displayedCourses.map((course) => (
              <div key={course.id} className="glass-card" style={{ padding: '24px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <div style={{ display: 'flex', alignItems: 'center', gap: '24px' }}>
                  <div style={{ width: '120px', height: '80px', borderRadius: 'var(--radius-sm)', background: 'var(--surface-hover)', overflow: 'hidden' }}>
                    {course.image ? <img src={course.image} alt={course.title} style={{ width: '100%', height: '100%', objectFit: 'cover' }} /> : <ImageIcon size={32} color="var(--text-muted)" style={{ margin: '24px auto', display: 'block' }} />}
                  </div>
                  <div>
                    <div style={{ display: 'flex', gap: '8px', alignItems: 'center', marginBottom: '4px' }}>
                      <h3 style={{ fontSize: '1.25rem' }}>{course.title}</h3>
                      <span className={`badge ${course.status === 'Published' ? 'badge-success' : course.status === 'Pending Approval' ? 'badge-warning' : 'badge-primary'}`} style={{ fontSize: '0.7rem' }}>{course.status}</span>
                    </div>
                    <p style={{ fontSize: '0.9rem', color: 'var(--text-muted)', display: 'flex', gap: '12px', marginBottom: '8px' }}>
                      <span>{course.category}</span><span>•</span><span>{course.duration}</span><span>•</span><span>{course.modules?.length || 0} Modules</span>
                    </p>
                  </div>
                </div>
                
                <div style={{ display: 'flex', gap: '12px' }}>
                  {isSuperuser && activeTab === 'admin_courses' && course.status === 'Pending Approval' && <button onClick={() => handleApprove(course.id)} className="btn btn-success" style={{ padding: '8px 16px' }}><Check size={18} /> Approve</button>}
                  <button onClick={() => handleStartEdit(course)} className="btn btn-secondary" style={{ padding: '8px', color: 'var(--primary)' }}><Edit3 size={18} /></button>
                  <button onClick={() => handleDelete(course.id)} className="btn btn-secondary" style={{ padding: '8px', color: 'var(--danger)' }}><Trash2 size={18} /></button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="app/globals.css">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700&display=swap');

:root {
  /* Core Palette */
  --primary: #00b4d8;       /* vibrant medical cyan */
  --primary-dark: #0077b6;
  --secondary: #219ebc;
  --accent: #ffb703;        /* warm accent */
  --success: #10b981;
  --danger: #ef4444;
  --surface: #ffffff;
  --surface-hover: #f8fafc;
  --background: #f1f5f9;
  --text-main: #0f172a;
  --text-muted: #64748b;
  --border: #e2e8f0;

  /* Glassmorphism */
  --glass-bg: rgba(255, 255, 255, 0.7);
  --glass-border: rgba(255, 255, 255, 0.2);
  --glass-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);

  /* Typography */
  --font-base: 'Inter', sans-serif;
  --font-heading: 'Outfit', sans-serif;

  /* Spacing & Borders */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 20px;
  --radius-full: 9999px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@media (prefers-color-scheme: dark) {
  :root {
    --primary: #48cae4;
    --primary-dark: #0096c7;
    --background: #0b1121;
    --surface: #1e293b;
    --surface-hover: #334155;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --border: #334155;
    
    --glass-bg: rgba(30, 41, 59, 0.7);
    --glass-border: rgba(255, 255, 255, 0.05);
    --glass-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
  }
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-base);
  background-color: var(--background);
  color: var(--text-main);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 600;
  line-height: 1.2;
  color: var(--text-main);
}

a {
  color: var(--primary);
  text-decoration: none;
  transition: var(--transition);
}

a:hover {
  color: var(--primary-dark);
}

/* Utilities */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Glass Card */
.glass-card {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
  border-radius: var(--radius-lg);
  padding: 32px;
  transition: var(--transition);
}

.glass-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 24px;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1rem;
  border-radius: var(--radius-full);
  border: none;
  cursor: pointer;
  transition: var(--transition);
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  box-shadow: 0 4px 15px rgba(0, 180, 216, 0.3);
}

.btn-primary:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 6px 20px rgba(0, 180, 216, 0.4);
  color: #fff;
}

.btn-secondary {
  background: var(--surface-hover);
  color: var(--text-main);
  border: 1px solid var(--border);
}

.btn-secondary:hover {
  background: var(--border);
}

.btn-accent {
  background: var(--accent);
  color: #000;
}

/* Layouts */
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
@media (max-width: 768px) {
  .grid-2, .grid-3 { grid-template-columns: 1fr; }
}

/* Badge */
.badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.badge-success { background: rgba(16, 185, 129, 0.1); color: var(--success); }
.badge-primary { background: rgba(0, 180, 216, 0.1); color: var(--primary); }
.badge-warning { background: rgba(255, 183, 3, 0.1); color: var(--accent); }

/* Navigation */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--glass-border);
  padding: 16px 0;
}

.navbar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.delay-1 { animation-delay: 0.1s; opacity: 0; }
.delay-2 { animation-delay: 0.2s; opacity: 0; }
.delay-3 { animation-delay: 0.3s; opacity: 0; }

/* Custom Inputs */
.input-group {
  margin-bottom: 20px;
}
.input-group label {
  display: block;
  margin-bottom: 8px;
  font-weight: 500;
  font-size: 0.9rem;
  color: var(--text-main);
}
.input-group input, .input-group select {
  width: 100%;
  padding: 12px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text-main);
  font-family: var(--font-base);
  transition: var(--transition);
}
.input-group input:focus, .input-group select:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.1);
}

/* Loading Spinner */
.spinner {
  width: 24px;
  height: 24px;
  border: 3px solid rgba(0, 180, 216, 0.3);
  border-radius: 50%;
  border-top-color: var(--primary);
  animation: spin 1s ease-in-out infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Subtle Gradient Text for Headers */
.gradient-text {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
</file>

