"use client";
import { useState, useEffect } from 'react';
import { Calendar as CalendarIcon, MapPin, Search, Globe, Clock, ChevronRight, BookOpen } from 'lucide-react';
import { useAuth } from '../../components/AuthProvider';
import { collection, getDocs, query, where, doc, setDoc } from 'firebase/firestore';
import { db } from '../../lib/firebase';

const generateMockSessions = (realCourses) => {
  const sessions = [];
  const today = new Date();
  const labs = [
    { id: 'l1', name: "Kampala Regional Referral Hospital", country: "Uganda", coords: "0.3476, 32.5825" },
    { id: 'l2', name: "Nairobi Clinical Center", country: "Kenya", coords: "-1.2921, 36.8219" },
    { id: 'l3', name: "Kigali General", country: "Rwanda", coords: "-1.9403, 30.0588" }
  ];

  if (!realCourses || realCourses.length === 0) return sessions;

  for (let i = 1; i <= 14; i++) { // Next 14 days
    const date = new Date(today);
    date.setDate(today.getDate() + i);
    const dateStr = date.toISOString().split('T')[0];
    
    // Assign some random sessions for this day
    if (i % 2 === 0 || i % 3 === 0) {
      // Pick a random course ID from the real database courses
      const randomCourse = realCourses[i % realCourses.length];
      sessions.push({
        id: `s-${i}`,
        date: dateStr,
        courseId: randomCourse.id,
        courseTitle: randomCourse.title,
        lab: labs[i % 3],
        blocks: [
          { time: "09:00 AM", total: 10, booked: Math.floor(Math.random() * 11) },
          { time: "02:00 PM", total: 15, booked: Math.floor(Math.random() * 16) }
        ]
      });
    }
  }
  return sessions;
};

export default function LabsPage() {
  const { user, profile, loginWithGoogle } = useAuth();
  
  const [courses, setCourses] = useState([]);
  const [sessionsData, setSessionsData] = useState([]);
  const [loading, setLoading] = useState(true);
  const [myBookings, setMyBookings] = useState([]);
  
  const [selectedCourse, setSelectedCourse] = useState(null);
  const [selectedDate, setSelectedDate] = useState(null);
  const [searchQuery, setSearchQuery] = useState('');
  const [bookingStatus, setBookingStatus] = useState(null);

  useEffect(() => {
    async function fetchCourses() {
      try {
        const q = query(collection(db, 'courses'), where('status', '==', 'Published'));
        const querySnapshot = await getDocs(q);
        const fetched = [];
        querySnapshot.forEach((doc) => {
          fetched.push({ id: doc.id, ...doc.data() });
        });
        setCourses(fetched);
        setSessionsData(generateMockSessions(fetched));
      } catch (err) {
        console.error("Error fetching courses", err);
      } finally {
        setLoading(false);
      }
    }
    fetchCourses();
  }, []);

  // Group sessions by available dates for the selected course
  const availableDates = selectedCourse 
    ? [...new Set(sessionsData.filter(s => s.courseId === selectedCourse).map(s => s.date))].sort()
    : [];

  const sessionsForDate = sessionsData.filter(s => 
    s.courseId === selectedCourse && 
    s.date === selectedDate &&
    (s.lab.country.toLowerCase().includes(searchQuery.toLowerCase()) || 
     s.lab.name.toLowerCase().includes(searchQuery.toLowerCase()))
  );

  const handleBook = async (sessionId, blockTime) => {
    if (!user) {
      alert("Please sign in to book a session.");
      loginWithGoogle();
      return;
    }

    setBookingStatus({ sessionId, time: blockTime, status: 'loading' });

    setTimeout(() => {
      // Decrement spots dynamically
      setSessionsData(prev => prev.map(s => {
        if (s.id === sessionId) {
          const updatedBlocks = s.blocks.map(b => b.time === blockTime ? { ...b, booked: b.booked + 1 } : b);
          return { ...s, blocks: updatedBlocks };
        }
        return s;
      }));

      // Add to my bookings
      const sessionDetails = sessionsData.find(s => s.id === sessionId);
      
      setMyBookings(prev => [...prev, {
        id: Date.now().toString(),
        sessionId: sessionId,
        time: blockTime,
        courseTitle: sessionDetails.courseTitle,
        date: sessionDetails.date,
        location: sessionDetails.lab.name
      }]);

      setBookingStatus({ sessionId, time: blockTime, status: 'success' });

      if (user && profile) {
        const newNotif = { id: Date.now().toString(), text: `Booking Confirmed: ${sessionDetails.courseTitle} at ${blockTime}`, time: "Just now", read: false };
        const currentNotifs = profile.notifications || [];
        setDoc(doc(db, 'users', user.uid), { notifications: [...currentNotifs, newNotif] }, { merge: true });
      }
    }, 400); // Fast, snappy response
  };

  return (
    <div className="animate-fade-in" style={{ paddingBottom: '80px' }}>
      <header style={{ marginBottom: '40px' }}>
        <h1 style={{ fontSize: '2.5rem', marginBottom: '8px' }}>Simulation Lab Booking</h1>
        <p style={{ color: 'var(--text-muted)', fontSize: '1.1rem', maxWidth: '600px', marginBottom: '24px' }}>
          Schedule hands-on practical sessions at accredited regional centers to complete your course requirements.
        </p>
      </header>

      {myBookings.length > 0 && (
        <section style={{ marginBottom: '40px' }} className="animate-fade-in">
          <h2 style={{ fontSize: '1.5rem', marginBottom: '16px', display: 'flex', alignItems: 'center', gap: '8px' }}>
            <CalendarIcon size={24} color="var(--primary)" /> My Upcoming Labs
          </h2>
          <div className="grid-3">
            {myBookings.map(booking => (
              <div key={booking.id} className="glass-card" style={{ padding: '20px', borderLeft: '4px solid var(--success)' }}>
                <p className="badge badge-success" style={{ marginBottom: '12px' }}>Confirmed</p>
                <h3 style={{ fontSize: '1.1rem', marginBottom: '8px', lineHeight: 1.3 }}>{booking.courseTitle}</h3>
                <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', color: 'var(--text-muted)', fontSize: '0.9rem' }}>
                  <span style={{ display: 'flex', alignItems: 'center', gap: '8px' }}><CalendarIcon size={14} /> {new Date(booking.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })} at {booking.time}</span>
                  <span style={{ display: 'flex', alignItems: 'center', gap: '8px' }}><MapPin size={14} /> {booking.location}</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <div className="grid-2" style={{ gap: '40px', alignItems: 'start', gridTemplateColumns: '1fr 2fr' }}>
        
        {/* Step 1: Selection Sidebar */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
          
          <div className="glass-card" style={{ padding: '24px' }}>
            <h3 style={{ fontSize: '1.1rem', marginBottom: '16px', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <span style={{ background: 'var(--primary)', color: '#fff', width: '24px', height: '24px', borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '0.85rem', fontWeight: 'bold' }}>1</span>
              Select Course
            </h3>
            
            <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
              {loading ? (
                <div style={{ padding: '20px', textAlign: 'center' }}><div className="spinner" style={{ width: '24px', height: '24px', borderWidth: '3px' }}></div></div>
              ) : courses.length === 0 ? (
                <p style={{ color: 'var(--text-muted)', fontSize: '0.9rem', padding: '12px' }}>No courses available.</p>
              ) : (
                courses.map(course => (
                  <button 
                    key={course.id}
                    onClick={() => { setSelectedCourse(course.id); setSelectedDate(null); }}
                    style={{ 
                      textAlign: 'left', padding: '12px 16px', borderRadius: 'var(--radius-md)', 
                      background: selectedCourse === course.id ? 'var(--primary-light)' : 'var(--surface)',
                      border: `1px solid ${selectedCourse === course.id ? 'var(--primary)' : 'var(--border)'}`,
                      color: selectedCourse === course.id ? 'var(--primary)' : 'var(--text-main)',
                      cursor: 'pointer', transition: 'all 0.2s', display: 'flex', justifyContent: 'space-between', alignItems: 'center'
                    }}
                  >
                    <span style={{ fontWeight: selectedCourse === course.id ? 600 : 400 }}>{course.title}</span>
                    {selectedCourse === course.id && <ChevronRight size={16} />}
                  </button>
                ))
              )}
            </div>
          </div>

          <div className="glass-card" style={{ padding: '24px', opacity: selectedCourse ? 1 : 0.5, pointerEvents: selectedCourse ? 'auto' : 'none' }}>
            <h3 style={{ fontSize: '1.1rem', marginBottom: '16px', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <span style={{ background: 'var(--primary)', color: '#fff', width: '24px', height: '24px', borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '0.85rem', fontWeight: 'bold' }}>2</span>
              Select Date
            </h3>
            
            {availableDates.length > 0 ? (
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: '8px' }}>
                {availableDates.map(date => {
                  const d = new Date(date);
                  const formatted = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
                  return (
                    <button 
                      key={date}
                      onClick={() => setSelectedDate(date)}
                      style={{ 
                        padding: '12px', borderRadius: 'var(--radius-md)', textAlign: 'center',
                        background: selectedDate === date ? 'var(--primary)' : 'var(--surface)',
                        color: selectedDate === date ? '#fff' : 'var(--text-main)',
                        border: `1px solid ${selectedDate === date ? 'var(--primary)' : 'var(--border)'}`,
                        cursor: 'pointer', transition: 'all 0.2s', fontSize: '0.9rem', fontWeight: 500
                      }}
                    >
                      {formatted}
                    </button>
                  );
                })}
              </div>
            ) : selectedCourse ? (
              <p style={{ color: 'var(--text-muted)', fontSize: '0.9rem', textAlign: 'center', padding: '20px 0' }}>No upcoming sessions for this course.</p>
            ) : (
              <p style={{ color: 'var(--text-muted)', fontSize: '0.9rem', textAlign: 'center', padding: '20px 0' }}>Select a course first.</p>
            )}
          </div>

        </div>

        {/* Step 3: Main Display Area */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
          
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-end', borderBottom: '1px solid var(--border)', paddingBottom: '16px' }}>
            <h2 style={{ fontSize: '1.5rem', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <span style={{ background: 'var(--primary)', color: '#fff', width: '28px', height: '28px', borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '1rem', fontWeight: 'bold' }}>3</span>
              Available Centers
            </h2>
            <div className="input-group" style={{ width: '250px', position: 'relative' }}>
              <Search size={18} style={{ position: 'absolute', left: '12px', top: '10px', color: 'var(--text-muted)' }} />
