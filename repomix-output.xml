"use client";
import React, { useState, useEffect } from 'react';
import { useAuth } from '../../../components/AuthProvider';
import { Lock, PlayCircle, CheckCircle, Clock, Award, FileText, ArrowLeft, Info } from 'lucide-react';
import Link from 'next/link';
import { doc, getDoc } from 'firebase/firestore';
import { db } from '../../../lib/firebase';


export default function CoursePage({ params }) {
  const { user, loginWithGoogle } = useAuth();
  const [course, setCourse] = useState(null);
  const [selectedModIdx, setSelectedModIdx] = useState(0);
  const [selectedTopIdx, setSelectedTopIdx] = useState(0);
  const unwrappedParams = React.use(params);
  const id = unwrappedParams.id;

  useEffect(() => {
    async function fetchCourse() {
      try {
        const docRef = doc(db, 'courses', id);
        const docSnap = await getDoc(docRef);
        if (docSnap.exists()) {
          setCourse({ id: docSnap.id, ...docSnap.data() });
        } else {
          setCourse(null);
        }
      } catch(err) {
        console.error("Error fetching course:", err);
      }
    }
    fetchCourse();
  }, [id]);

  if (!course) return <div style={{ padding: '100px', textAlign: 'center' }}><div className="spinner"></div></div>;

  return (
    <div className="animate-fade-in" style={{ paddingBottom: '80px' }}>
      <Link href="/" style={{ display: 'flex', alignItems: 'center', gap: '8px', color: 'var(--text-muted)', textDecoration: 'none', marginBottom: '24px', fontWeight: 500, width: 'fit-content' }}>
        <ArrowLeft size={20} /> Back to Courses
      </Link>

      <div className="grid-2" style={{ gap: '40px', alignItems: 'start', gridTemplateColumns: '1fr 350px' }}>
        
        {/* Main Content Area */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '24px', minWidth: 0 }}>
          
          <div>
            <div className="badge badge-warning" style={{ marginBottom: '12px' }}>{course.category}</div>
            <h1 style={{ fontSize: '2rem', marginBottom: '16px', lineHeight: 1.2 }}>{course.title}</h1>
            <p style={{ color: 'var(--text-muted)', fontSize: '1.1rem', lineHeight: 1.6 }}>
              {course.description}
            </p>
          </div>

          <div style={{ display: 'flex', gap: '24px', padding: '16px 24px', background: '#fff', borderRadius: 'var(--radius-md)', border: '1px solid #f1f5f9', boxShadow: '0 4px 20px rgba(0,0,0,0.02)' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
              <Clock size={20} color="var(--primary)" />
              <div>
                <p style={{ fontSize: '0.85rem', color: '#64748b' }}>Duration</p>
                <p style={{ fontWeight: 600, color: '#0f172a' }}>{course.duration}</p>
              </div>
            </div>
            <div style={{ width: '1px', background: '#f1f5f9' }} />
            <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
              <Award size={20} color="var(--accent)" />
              <div>
                <p style={{ fontSize: '0.85rem', color: '#64748b' }}>CPD Points</p>
                <p style={{ fontWeight: 600, color: '#0f172a' }}>{course.cpd}</p>
              </div>
            </div>
          </div>

          {/* Dynamic Content */}
          {!user ? (
            <div style={{ width: '100%', aspectRatio: '16/9', background: '#000', borderRadius: 'var(--radius-lg)', overflow: 'hidden', position: 'relative' }}>
              <img src={course.image} alt={course.title} style={{ width: '100%', height: '100%', objectFit: 'cover', opacity: 0.5 }} />
              <div style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', background: 'rgba(3, 4, 94, 0.8)', backdropFilter: 'blur(8px)', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', padding: '32px', textAlign: 'center' }}>
                <Lock size={48} color="var(--primary)" style={{ marginBottom: '16px' }} />
                <h3 style={{ color: '#fff', fontSize: '1.5rem', marginBottom: '12px' }}>Unlock Full Access</h3>
                <p style={{ color: 'rgba(255,255,255,0.8)', marginBottom: '24px', maxWidth: '400px' }}>
                  Register or sign in to continue watching this module, access resources, and earn your CPD points.
                </p>
                <button onClick={loginWithGoogle} className="btn btn-primary" style={{ padding: '12px 32px', fontSize: '1.1rem' }}>
                  Sign In to Continue
                </button>
              </div>
            </div>
          ) : course.modules && course.modules.length > 0 ? (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '32px', marginTop: '16px' }}>
              {(() => {
                const currentTopic = course.modules[selectedModIdx]?.topics?.[selectedTopIdx];
                if (!currentTopic) return <div style={{ padding: '40px', textAlign: 'center', background: '#fff', borderRadius: 'var(--radius-lg)', border: '1px solid #f1f5f9' }}>No content available for this topic.</div>;
                
                return (
                  <>
                    <h2 style={{ fontSize: '1.75rem', borderBottom: '1px solid #e2e8f0', paddingBottom: '12px', color: '#0f172a' }}>{currentTopic.title}</h2>
                    
                    {/* Video Players */}
                    {currentTopic.resources?.filter(r => r.type === 'video').map((res, i) => (
                       <div key={i} style={{ width: '100%', aspectRatio: '16/9', background: '#000', borderRadius: 'var(--radius-lg)', overflow: 'hidden', boxShadow: '0 10px 30px rgba(0,0,0,0.1)' }}>
                          <video src={res.url} controls style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
                       </div>
                    ))}

                    {/* Rich Text Content */}
                    {currentTopic.content && (
                      <div style={{ padding: '32px', whiteSpace: 'pre-wrap', lineHeight: 1.8, fontSize: '1.05rem', color: '#334155', background: '#fff', borderRadius: 'var(--radius-lg)', border: '1px solid #f1f5f9', boxShadow: '0 4px 20px rgba(0,0,0,0.02)' }}>
                        {currentTopic.content}
                      </div>
                    )}

                    {/* Other Resources */}
                    {currentTopic.resources?.filter(r => r.type !== 'video').length > 0 && (
                      <div style={{ background: '#f8fafc', padding: '24px', borderRadius: 'var(--radius-md)', border: '1px solid #e2e8f0' }}>
                        <h4 style={{ marginBottom: '16px', display: 'flex', alignItems: 'center', gap: '8px', color: '#0f172a' }}><FileText size={18} color="var(--primary)" /> Topic Resources</h4>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
                          {currentTopic.resources.filter(r => r.type !== 'video').map((res, i) => (
                            <a key={i} href={res.url} target="_blank" rel="noreferrer" style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '16px', background: '#fff', borderRadius: 'var(--radius-sm)', textDecoration: 'none', color: '#334155', border: '1px solid #e2e8f0', transition: 'all 0.2s', boxShadow: '0 2px 8px rgba(0,0,0,0.02)' }}>
                              <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                                {res.type === 'pdf' ? <FileText size={20} color="var(--primary)"/> : <PlayCircle size={20} color="var(--accent)"/>}
                                <span style={{ fontWeight: 500 }}>{res.title}</span>
                              </div>
                              <span style={{ fontSize: '0.85rem', color: 'var(--primary)', fontWeight: 600 }}>Open Resource &rarr;</span>
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </>
                );
              })()}
            </div>
          ) : (
            <div style={{ width: '100%', aspectRatio: '16/9', background: '#000', borderRadius: 'var(--radius-lg)', overflow: 'hidden' }}>
               <video src={course.videoUrl} controls poster={course.image} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
            </div>
          )}
        </div>

        {/* Sidebar */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
          
          <div style={{ padding: '24px', background: '#fff', borderRadius: 'var(--radius-lg)', border: '1px solid #f1f5f9', boxShadow: '0 4px 20px rgba(0,0,0,0.02)' }}>
            <h3 style={{ fontSize: '1.25rem', marginBottom: '24px', borderBottom: '1px solid #e2e8f0', paddingBottom: '12px', color: '#0f172a' }}>Course Syllabus</h3>
            
            <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
              {course.modules && course.modules.length > 0 ? (
                course.modules.map((mod, mIdx) => (
                  <div key={mIdx}>
                    <div style={{ fontWeight: 600, color: '#0f172a', marginBottom: '12px', fontSize: '1.05rem' }}>{mIdx + 1}. {mod.title}</div>
                    
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '4px', paddingLeft: '16px', borderLeft: '2px solid #e2e8f0' }}>
                      {mod.topics?.map((topic, tIdx) => {
                        const isActive = selectedModIdx === mIdx && selectedTopIdx === tIdx;
                        return (
                          <button 
                            key={tIdx}
                            onClick={() => {
                               if (!user) { loginWithGoogle(); return; }
                               setSelectedModIdx(mIdx); 
                               setSelectedTopIdx(tIdx);
                            }}
                            style={{ 
                              background: isActive ? '#f8fafc' : 'transparent', 
                              border: 'none', textAlign: 'left',
                              color: isActive ? 'var(--primary)' : '#64748b',
                              fontWeight: isActive ? 600 : 400,
                              cursor: 'pointer',
                              display: 'flex', alignItems: 'center', gap: '8px',
                              padding: '8px 12px', borderRadius: 'var(--radius-sm)', transition: 'all 0.2s'
                            }}
                          >
                            {!user ? <Lock size={14} color="#94a3b8" style={{ flexShrink: 0 }} /> : <PlayCircle size={14} color={isActive ? "var(--primary)" : "#94a3b8"} style={{ flexShrink: 0 }} />}
                            <span style={{ lineHeight: 1.3 }}>{topic.title}</span>
                          </button>
                        );
                      })}
                    </div>
                  </div>
                ))
              ) : (
                <p style={{ color: '#64748b', fontSize: '0.9rem' }}>No modules available.</p>
              )}
            </div>
          </div>

          <div className="glass-card" style={{ padding: '24px', background: 'rgba(0,180,216,0.05)', border: '1px solid rgba(0,180,216,0.2)' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '12px', marginBottom: '16px' }}>
              <Info size={24} color="var(--primary)" />
              <h3 style={{ fontSize: '1.1rem' }}>Practical Requirement</h3>
            </div>
            <p style={{ color: 'var(--text-muted)', fontSize: '0.95rem', marginBottom: '20px' }}>
              This course requires a mandatory in-person simulation session at an accredited lab.
            </p>
            <Link href="/labs" className="btn btn-secondary" style={{ width: '100%', justifyContent: 'center' }}>
              View Lab Availability
            </Link>
          </div>

        </div>
      </div>
    </div>
  );
}
